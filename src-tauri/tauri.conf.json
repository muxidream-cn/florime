{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "florime",
  "version": "0.1.1",
  "identifier": "com.muxidream.florime",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "莳间",
        "width": 1180,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4OTFGNkIzRDIwMjk2OUMKUldTY2xnTFNzL2FSQ0srbDFmYUZvMUJIVkJ3NUlGQU5xekFSRVRCbERRTHA2Wjl4RzJXRUhFZDgK",
      "endpoints": ["https://github.com/muxidream-cn/florime/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
