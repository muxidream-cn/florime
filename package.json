  "type": "module",
  "scripts": {
    "app:build": "tauri build",
    "app:dev": "tauri dev",
    "build": "vue-tsc --noEmit && vite build",
    "check": "eslint .",
    "check:prettier": "prettier --check .",
    "commit": "lint-staged && cz",
    "dev": "vite",
    "lint": "eslint . --fix",
    "lint:commitlint": "commitlint --edit $1",
    "lint:prettier": "prettier . --write",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview": "vite preview",
    "tauri": "tauri",
    "updateVersion": "node scripts/updateVersion.js"
  },
  "lint-staged": {
    "**/*.{cjs,mjs,js,jsx,tsx,ts,vue,less}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@lucide/vue": "^1.74.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dayjs": "^1.11.23",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.9.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "commander": "^15.1.0",
    "cz-git": "^1.12.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "semver": "^7.8.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.14"
  }
